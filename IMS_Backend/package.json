{
  "name": "ims-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx prisma migrate dev --schema src/database/prisma/schema.prisma",
    "migrate:prod": "npx prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema src/database/prisma/schema.prisma",
    "generate": "npx prisma generate --schema src/database/prisma/schema.prisma",
    "seed": "node src/database/prisma/seeds/permissionSeeder.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Inventory Management System backend: Express 5 REST API with Prisma/PostgreSQL and Redis sessions",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0"
  }
}
