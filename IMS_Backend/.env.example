# ---- Server ----
NODE_ENV=development
PORT=3000
# Set to true only when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=false

# ---- Database (PostgreSQL via Prisma) ----
DATABASE_URL=postgresql://username:password@localhost:5432/ims_db

# ---- Authentication ----
# Use two DIFFERENT long random strings, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# ---- CORS (comma-separated list of allowed browser origins) ----
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- Redis (session store). Optional: falls back to in-memory if unreachable ----
REDIS_URL=redis://localhost:6379

# ---- Only needed for `npm run seed` (demo users). At least 12 characters ----
SEED_DEFAULT_PASSWORD=replace-with-a-unique-password
